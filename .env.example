# ===== Copie este arquivo para .env antes de subir o projeto =====
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=pulsepay
POSTGRES_PASSWORD=pulsepay123
POSTGRES_DB=pulsepay
POSTGRES_PORT=5432
# connection_limit: tamanho do pool de conexões do Prisma por processo
# (API e Worker cada um mantém o seu). O padrão do Prisma é calculado a
# partir do nº de CPUs (às vezes só 3-5 conexões), o que estrangula sob
# carga (ex.: teste de carga k6 da seção 6) - por isso fixamos um valor
# maior aqui.
DATABASE_URL=postgresql://pulsepay:pulsepay123@postgres:5432/pulsepay?schema=public&connection_limit=20&pool_timeout=20

# --- RabbitMQ ---
RABBITMQ_USER=pulsepay
RABBITMQ_PASSWORD=pulsepay123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pulsepay:pulsepay123@rabbitmq:5672
RABBITMQ_QUEUE_TRANSFERENCIAS=transferencias
RABBITMQ_QUEUE_NOTIFICACOES=notificacoes

# --- Backend / API ---
API_PORT=4000
JWT_SECRET=troque_esse_segredo_em_producao_pulsepay
JWT_EXPIRES_IN=1h
NODE_ENV=development
# Quantas mensagens o Worker processa em paralelo (ver worker/worker.js)
WORKER_PREFETCH=50

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000

# --- Observabilidade ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
