# --- PostgreSQL ---
POSTGRES_USER=pulsepay
POSTGRES_PASSWORD=pulsepay123
POSTGRES_DB=pulsepay
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulsepay:pulsepay123@postgres:5432/pulsepay?schema=public

# --- RabbitMQ ---
RABBITMQ_USER=pulsepay
RABBITMQ_PASSWORD=pulsepay123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pulsepay:pulsepay123@rabbitmq:5672
RABBITMQ_QUEUE_TRANSFERENCIAS=transferencias
RABBITMQ_QUEUE_NOTIFICACOES=notificacoes

# --- Backend / API ---
API_PORT=4000
JWT_SECRET=troque_esse_segredo_em_producao_pulsepay
JWT_EXPIRES_IN=1h
NODE_ENV=development

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000

# --- Observabilidade ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
