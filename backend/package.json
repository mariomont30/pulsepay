{
  "name": "pulsepay-backend",
  "version": "1.0.0",
  "description": "API + Worker do PulsePay (projeto acadêmico)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node worker/worker.js",
    "worker:dev": "nodemon worker/worker.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:adr": "jest --config jest.adr.config.js --runInBand",
    "test:integracao": "node scripts/rodar-testes-integracao.js",
    "test:fluxo-assincrono": "node scripts/testar-fluxo-assincrono.js",
    "test:concorrencia": "node scripts/testar-concorrencia.js",
    "test:imutabilidade": "node scripts/testar-imutabilidade.js",
    "lint": "eslint src worker"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0"
  }
}
